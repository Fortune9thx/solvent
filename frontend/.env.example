# Solvent frontend configuration.
#
# If VITE_CONTRACT_ADDRESS is empty, or the network is reset and the address
# stops resolving, the app renders its real empty state and says which of
# those is true -- it never invents units, claims or verdicts.
VITE_CONTRACT_ADDRESS=
VITE_GENLAYER_RPC_URL=https://studio-dev.genlayer.com/api
VITE_GENLAYER_CHAIN_ID=61997
VITE_EXPLORER=https://explorer-studio-dev.genlayer.com
